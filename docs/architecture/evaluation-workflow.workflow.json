  "cards": [
    {
      "dot": "violet",
      "title": "Condition Semantics",
      "items": [
        "L1 and Oracle are configured one-shot paths; L2 is a fixed two-stage workflow",
        "L3 performs deterministic static retrieval before its single model call",
        "L4 enters the self-built ReAct runtime with a frozen Case workspace and tools"
      ]
    },
    {
      "dot": "cyan",
      "title": "Evidence Streams Stay Distinct",
      "items": [
        "TraceRecorder captures run, sample, executor, provider-attempt, and runtime lifecycle events",
        "Only L4 carries the exact message trajectory; SQLite persists it separately from Trace",
        "Reports, validation, scores, diagnostics, aggregates, and run files remain separate evidence layers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Outcome + Durability Rules",
      "items": [
        "Cases may run concurrently; repeats within each Case stay sequential; results restore sample_sequence order",
        "Malformed model output can still be deterministically scored; execution failure has no report or score",
        "Sample failures continue through aggregation and may yield completed_with_sample_failures",
        "DB completion precedes JSON/Markdown from the in-memory document; trajectories stay unexported"
      ]
    }
  ]
